{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {"contentSize":"1280px","wideSize":"1440px"},
    "color": {"defaultPalette":false,"palette":[{"slug":"ink","name":"Графит","color":"#141514"},{"slug":"paper","name":"Светлый","color":"#f2f3ed"},{"slug":"lime","name":"Лайм","color":"#d4fa48"},{"slug":"muted","name":"Серый","color":"#a5a89e"}]},
    "typography": {"fluid":true,"fontFamilies":[{"fontFamily":"Manrope, Arial, sans-serif","slug":"manrope","name":"Manrope"}],"fontSizes":[{"slug":"small","size":"0.875rem","name":"Маленький"},{"slug":"medium","size":"1.125rem","name":"Основной"},{"slug":"large","size":"2rem","name":"Большой"},{"slug":"display","size":"6rem","name":"Заголовок"}]},
    "spacing":{"units":["px","rem","%","vw"],"blockGap":"0"}
  },
  "styles": {
    "color":{"background":"var:preset|color|ink","text":"var:preset|color|paper"},
    "typography":{"fontFamily":"var:preset|font-family|manrope","fontSize":"1.125rem","lineHeight":"1.6"},
    "elements":{"link":{"color":{"text":"inherit"},"typography":{"textDecoration":"none"}},"heading":{"typography":{"fontWeight":"500","lineHeight":"1.06","letterSpacing":"-0.055em"}},"button":{"border":{"radius":"100px"},"color":{"background":"var:preset|color|lime","text":"var:preset|color|ink"},"typography":{"fontWeight":"600","fontSize":"1rem"},"spacing":{"padding":{"top":"18px","bottom":"18px","left":"30px","right":"30px"}}}}
  },
  "templateParts":[{"name":"header","title":"Шапка сайта","area":"header"},{"name":"footer","title":"Подвал сайта","area":"footer"}]
}
